CREATE TABLE user_cache (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    email TEXT NOT NULL,
    gender TEXT NOT NULL,
    status TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

insertUser:
INSERT OR REPLACE INTO user_cache(id, name, email, gender, status, cached_at)
VALUES (?, ?, ?, ?, ?, ?);

clearAll:
DELETE FROM user_cache;

-- Users added in the app have a newer cached_at, so they come first, matching the online feed.
selectAll:
SELECT * FROM user_cache ORDER BY cached_at DESC, id ASC;


deleteUser:
DELETE FROM user_cache WHERE id = ?;